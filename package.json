{
  "name": "hamza-agency",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "npm run verify:translations",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "verify:translations": "node scripts/verify-public-translations.mjs",
    "verify:migrations": "node scripts/verify-safe-migrations.mjs",
    "verify:secrets": "node scripts/verify-no-client-secrets.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:smoke": "node scripts/runtime-smoke-test.mjs",
    "test:e2e": "npx --yes @playwright/test@1.55.0 test --config=playwright.config.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@types/node": "^26.1.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.5.4",
    "eslint": "^10.8.0",
    "eslint-config-next": "^16.2.12",
    "postcss": "^8.5.23",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
