{
  "name": "hamza-agency",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "npm run verify:translations && npm run verify:product-expansion && npm run verify:pr4 && npm run verify:admin-mutations",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "verify:translations": "node scripts/verify-public-translations.mjs",
    "verify:migrations": "node scripts/verify-safe-migrations.mjs && node scripts/verify-pr116-admin-entity-privileges.mjs",
    "verify:dependencies": "node scripts/verify-dependency-security.mjs",
    "verify:product-expansion": "node scripts/verify-pr101-product-expansion.mjs",
    "verify:pr4": "node --test tests/pr4-smart-support.test.mjs",
    "verify:admin-mutations": "node --test tests/admin-mutation-boundary.test.mjs",
    "verify:secrets": "node scripts/verify-no-client-secrets.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:smoke": "node scripts/runtime-smoke-test.mjs",
    "test:e2e": "playwright test --config=playwright.config.mjs",
    "test:closeout": "playwright test --config=playwright.closeout.config.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.112.2",
    "next": "^15.5.24",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "1.63.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.6.1",
    "eslint": "^10.11.0",
    "eslint-config-next": "16.3.8",
    "postcss": "8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "browserslist": "4.28.9",
    "baseline-browser-mapping": "2.11.22",
    "postcss-selector-parser": "6.1.3",
    "@eslint/eslintrc": {
      "js-yaml": "4.3.2",
      "minimatch": {
        "brace-expansion": "1.1.21"
      }
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": {
        "brace-expansion": "5.0.12"
      }
    }
  }
}
