# HAMZA AGENCY public environment variables
# Copy to .env.local for local development.
# Never commit real values, private backups, Service Role keys, or tokens.

# Public Supabase connection only
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Official public website URL
NEXT_PUBLIC_SITE_URL=https://hamza-agency.com

# Public contact settings
NEXT_PUBLIC_WHATSAPP_NUMBER=YOUR_PUBLIC_WHATSAPP_NUMBER

# Public language settings
NEXT_PUBLIC_DEFAULT_LANGUAGE=ar
NEXT_PUBLIC_SUPPORTED_LANGUAGES=ar,en,tr

# Public AI support switch
NEXT_PUBLIC_AI_SUPPORT_ENABLED=true

# Vercel OIDC
# The server obtains deployment identity from Vercel at runtime.
# Do not create NEXT_PUBLIC OIDC variables and do not add a shared RPC HMAC secret.
