# HAMZA AGENCY environment variables
# Copy this file to .env.local for local development.
# Never commit real secret keys or service-role keys.

# Public Supabase connection only
# Keep the service-role key outside the frontend project and Vercel public variables.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Public website URL
# Use https://hamza-agency.vercel.app before connecting the official domain.
# Later update it to https://hamza-agency.com after domain integration.
NEXT_PUBLIC_SITE_URL=https://hamza-agency.vercel.app

# Public contact settings
NEXT_PUBLIC_WHATSAPP_NUMBER=905011730377
