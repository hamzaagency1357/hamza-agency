# ─────────────────────────────────────────────────────────────────────────────
# HAMZA AGENCY — Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in your actual values.
# NEVER commit .env.local to Git. It is already in .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

# ─── SUPABASE ────────────────────────────────────────────────────────────────
# Get these from: https://supabase.com → Your Project → Settings → API

# The public URL of your Supabase project (safe to expose in frontend)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co

# The anon/public key (safe to expose in frontend — row-level security protects data)
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# The service role key (NEVER expose this in frontend — server-side only)
# Used for admin operations that bypass Row Level Security
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY


# ─── APP CONFIG ──────────────────────────────────────────────────────────────

# Your production domain (no trailing slash)
NEXT_PUBLIC_APP_URL=https://hamzaagency.com

# App name (used in metadata and emails)
NEXT_PUBLIC_APP_NAME=Hamza Agency

# Default locale: en | ar | tr
NEXT_PUBLIC_DEFAULT_LOCALE=en


# ─── WHATSAPP ────────────────────────────────────────────────────────────────
# WhatsApp Business number (international format, no + or spaces)
# Example: 971501234567 (UAE number)
NEXT_PUBLIC_WHATSAPP_NUMBER=971501234567

# Default WhatsApp greeting message (URL-encoded in config/whatsapp.ts)
NEXT_PUBLIC_WHATSAPP_DEFAULT_MESSAGE=Hello, I'm interested in your services.


# ─── ANALYTICS (Phase 2+) ────────────────────────────────────────────────────
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_META_PIXEL_ID=XXXXXXXXXX


# ─── EMAIL (Phase 2+) ────────────────────────────────────────────────────────
# RESEND_API_KEY=re_XXXXXXXXXX
# EMAIL_FROM=noreply@hamzaagency.com


# ─── PAYMENTS (Phase 3+) ─────────────────────────────────────────────────────
# STRIPE_SECRET_KEY=sk_live_XXXXXXXXXX
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_XXXXXXXXXX


# ─── AI (Phase 4+) ───────────────────────────────────────────────────────────
# ANTHROPIC_API_KEY=sk-ant-XXXXXXXXXX
# OPENAI_API_KEY=sk-XXXXXXXXXX
